{"tier": "multi_step", "query": "Compare the yearly ordering plus holding cost of ordering 1,000 versus 3,000 units at a time: demand 36,000 per year, ordering cost $80, holding cost $3 per unit-year. Which is cheaper?", "intent": "cost_analysis", "required_tools": ["calculator"], "expected_tool_calls": [{"tool": "inventory_calculator", "args": {"operation": "total_annual_cost", "params": {"annual_demand": 36000, "order_quantity": 1000, "order_cost": 80, "holding_cost_per_unit": 3.0, "unit_cost": 0}}}, {"tool": "inventory_calculator", "args": {"operation": "total_annual_cost", "params": {"annual_demand": 36000, "order_quantity": 3000, "order_cost": 80, "holding_cost_per_unit": 3.0, "unit_cost": 0}}}], "grading": {"type": "numeric", "expected": {"cost_q1000": 4380.0, "cost_q3000": 5460.0}, "rel_tol": 0.01}, "completion_criteria": ["Cost at 1,000 = $4,380", "Cost at 3,000 = $5,460", "Names the cheaper option"], "notes": "", "id": "eval_034"}
{"tier": "multi_step", "query": "Forecast demand for FOODS_3_586 at store CA_2 over the next 28 days, calculate the EOQ with ordering cost $55 and holding cost $2/unit-year (annualize the forecast), and simulate stockout risk with 800 units on hand, a 10-day lead time and demand standard deviation of 12.", "intent": "procurement_optimization", "required_tools": ["calculator", "forecast", "python"], "expected_tool_calls": [{"tool": "forecast_demand", "args": {"item_id": "FOODS_3_586", "store_id": "CA_2", "horizon_days": 28}}, {"tool": "inventory_calculator", "args": {"operation": "eoq", "params": {"annual_demand": "$step1.mean_daily_demand * 365", "order_cost": 55, "holding_cost_per_unit": 2.0}}}, {"tool": "python_analysis", "args": {"task": "monte_carlo_stockout", "params": {"on_hand": 800, "mean_daily_demand": "$step1.mean_daily_demand", "std_daily_demand": 12, "lead_time_days": 10}}}], "grading": {"type": "forecast_dep", "reference_fn": ["eoq", "stockout_probability_normal"], "reference_args": [{"annual_demand": "$step1.mean_daily_demand * 365", "order_cost": 55, "holding_cost_per_unit": 2.0}, {"on_hand": 800, "mean_daily_demand": "$step1.mean_daily_demand", "std_daily_demand": 12, "lead_time_days": 10}], "rel_tol": 0.01, "abs_tol_prob": 0.03}, "completion_criteria": ["All three tools used", "Same forecast mean feeds both EOQ and the simulation", "Reports EOQ and stockout probability"], "notes": "", "id": "eval_035"}
{"tier": "multi_step", "query": "Search for a typical per-unit price of stainless steel water bottles online, then tell me how many I can buy with a $5,000 budget.", "intent": "procurement_optimization", "required_tools": ["calculator", "web_search"], "expected_tool_calls": [{"tool": "web_search", "args": {"query": "stainless steel water bottle price per unit wholesale"}}, {"tool": "inventory_calculator", "args": {"operation": "budget_coverage", "params": {"budget": 5000, "unit_cost": "$extract(step1.results, unit_price)"}}}], "grading": {"type": "rubric", "consistency_check": "units == floor(5000 / price_quoted_by_agent)"}, "completion_criteria": ["Price comes from search results with source", "Units = floor(5000 / price) computed with the calculator", "States price assumption clearly"], "notes": "", "id": "eval_036"}
{"tier": "multi_step", "query": "Forecast demand for FOODS_3_586 at store CA_2 over the next 14 days, search for packaging suppliers that could deliver within 10 days, and compute the reorder point with a 10-day lead time and 50 units of safety stock.", "intent": "inventory_optimization", "required_tools": ["calculator", "forecast", "web_search"], "expected_tool_calls": [{"tool": "forecast_demand", "args": {"item_id": "FOODS_3_586", "store_id": "CA_2", "horizon_days": 14}}, {"tool": "web_search", "args": {"query": "packaging suppliers delivery within 10 days"}}, {"tool": "inventory_calculator", "args": {"operation": "reorder_point", "params": {"avg_daily_demand": "$step1.mean_daily_demand", "lead_time_days": 10, "safety_stock": 50}}}], "grading": {"type": "forecast_dep", "reference_fn": "reorder_point", "reference_args": {"avg_daily_demand": "$step1.mean_daily_demand", "lead_time_days": 10, "safety_stock": 50}, "rel_tol": 0.01, "also_rubric": true}, "completion_criteria": ["ROP consistent with forecast", "Supplier info from search results only, with sources"], "notes": "", "id": "eval_037"}
